@model BookManagement.Models.Book

<h2>Thêm sách</h2>

<form method="post">

    <div>
        <label>Id</label>
        <input type="number" name="Id" />
    </div>

    <br />

    <div>
        <label>Tên sách</label>
        <input type="text" name="Name" />
    </div>

    <br />

    <div>
        <label>Giá</label>
        <input type="number" name="Price" />
    </div>

    <br />

    <button type="submit">
        Thêm
    </button>

</form>

@if (ViewBag.Message != null)
{
    <h3>@ViewBag.Message</h3>
}