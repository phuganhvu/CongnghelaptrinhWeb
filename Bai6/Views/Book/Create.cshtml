@model Bai6.Models.Book

<h2>Thêm sách</h2>

<form method="post">

    <div>
        <label>Id</label>
        <input asp-for="Id" />
    </div>

    <br />

    <div>
        <label>Tên sách</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"
              style="color:red">
        </span>
    </div>

    <br />

    <div>
        <label>Giá</label>
        <input asp-for="Price" />
        <span asp-validation-for="Price"
              style="color:red">
        </span>
    </div>

    <br />

    <button type="submit">
        Thêm
    </button>

</form>

@if (ViewBag.Message != null)
{
    <h3 style="color:blue">@ViewBag.Message</h3>
}