@model Book
@{
    ViewData["Title"] = "Xóa sách";
}

<h1>Xóa sách</h1>

<h3>Bạn có chắc muốn xóa sách này?</h3>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Tên sách</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Tác giả</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Giá</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N2")</dd>

    <dt class="col-sm-2">Ngày xuất bản</dt>
    <dd class="col-sm-10">@Model.PublishDate.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
