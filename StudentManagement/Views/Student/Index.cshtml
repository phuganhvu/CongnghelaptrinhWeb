@model List<Student>
@{
    ViewData["Title"] = "Danh sách sinh viên";
    var search = ViewBag.Search as string;
    var sortBy = ViewBag.SortBy as string ?? "Id";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    string NextOrder(string column) =>
        sortBy.Equals(column, StringComparison.OrdinalIgnoreCase) && sortOrder == "asc" ? "desc" : "asc";
}

<h2 class="mb-4">Danh sách sinh viên</h2>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo tên, email, SĐT..." />
        <input type="hidden" name="sortBy" value="@sortBy" />
        <input type="hidden" name="sortOrder" value="@sortOrder" />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
        }
    </form>
    <a asp-action="Create" class="btn btn-success">Thêm sinh viên mới</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Chưa có dữ liệu sinh viên.</p>
}
else
{
    <p>Danh sách có @Model.Count sinh viên.</p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortBy="Id" asp-route-sortOrder="@NextOrder("Id")" class="text-white text-decoration-none">
                            ID @(sortBy == "Id" ? (sortOrder == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortBy="Name" asp-route-sortOrder="@NextOrder("Name")" class="text-white text-decoration-none">
                            Tên @(sortBy == "Name" ? (sortOrder == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortBy="Email" asp-route-sortOrder="@NextOrder("Email")" class="text-white text-decoration-none">
                            Email @(sortBy == "Email" ? (sortOrder == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-search="@search" asp-route-sortBy="Phone" asp-route-sortOrder="@NextOrder("Phone")" class="text-white text-decoration-none">
                            SĐT @(sortBy == "Phone" ? (sortOrder == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th style="width: 220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        console.log("Trang danh sách sinh viên đã được tải");
    </script>
}
